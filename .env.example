# ========== 飞书应用配置（必填）==========
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# 推送目标 chat_id 列表（逗号分隔）
FEISHU_CHAT_IDS=oc_xxxxxxxxxxxx

# ========== Telegram Bot 配置（可选）==========
# Telegram Bot Token（@BotFather 获取）；留空则 Telegram 平台静默禁用
TELEGRAM_BOT_TOKEN=123456:ABCdef

# ========== Discord Bot 配置（可选）==========
# Discord Bot Token（Developer Portal 创建 bot 获取）；留空则 Discord 平台静默禁用
# 注意：需在 Developer Portal 开启 Message Content Intent 才能收到频道 @Bot 消息
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxx
# 可选：限定单服务器，便于选择默认接收频道
DISCORD_GUILD_ID=

# ========== LLM 配置 ==========
# 当前使用的厂商：openai | anthropic | deepseek
LLM_PROVIDER=openai
# 具体模型名称（留空则使用厂商默认：gpt-4o-mini / claude-sonnet-4-6 / deepseek-chat）
LLM_MODEL=
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 单次 LLM 调用超时（秒）。必须有界：挂起的调用会永久占用查询池 worker
LLM_TIMEOUT_SECONDS=60
# SDK 层重试次数（节点层另有自己的重试逻辑）
LLM_MAX_RETRIES=2

# ========== 管理接口配置 ==========
# /admin/* 端点访问令牌，请求需带 header: X-Admin-Token: <token>
# 留空则管理端点整体禁用（fail-closed）—— 这些端点可触发群发消息和批量 embedding 计费
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# ========== 并发查询池配置 ==========
# 查询池 worker 数（LLM rate limit 是实际瓶颈）
QUERY_MAX_WORKERS=10
# 有界队列容量，打满后丢弃新请求并回「系统繁忙」
QUERY_MAX_QUEUE=50
# 等待队列空位的超时（秒）
QUERY_QUEUE_TIMEOUT_SECONDS=0.5
# 每用户查询最小间隔（秒），0=关闭限流
QUERY_RATE_LIMIT_SECONDS=2.0

# ========== 可观测性配置 ==========
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ========== MySQL 配置 ==========
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DATABASE=lark_news

# ========== Redis 配置 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
